# Copy to .env and set a strong local-only SQL Server password.
# Use at least 8 characters with uppercase, lowercase, digits, and a symbol.
MSSQL_SA_PASSWORD=

# Optional local operator account with all currently implemented admin permissions.
# Set Enabled=true and choose your own password before its first creation.
DEFAULT_ADMIN_ENABLED=false
DEFAULT_ADMIN_EMAIL=admin@ecommerce.local
DEFAULT_ADMIN_PASSWORD=
