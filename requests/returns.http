@baseUrl = http://127.0.0.1:5088
@ownerToken = REPLACE_OWNER_TOKEN
@returnAdminToken = REPLACE_RETURN_ADMIN_TOKEN
@orderId = REPLACE_DELIVERED_ORDER_ID
@returnId = REPLACE_RETURN_ID

### Request a whole-order return
POST {{baseUrl}}/orders/{{orderId}}/returns
Authorization: Bearer {{ownerToken}}
Idempotency-Key: return-001
Content-Type: application/json

{"reason":"Damaged on arrival"}

### Read your return and live financial totals
GET {{baseUrl}}/orders/{{orderId}}/return
Authorization: Bearer {{ownerToken}}

### Admin list
GET {{baseUrl}}/admin/returns?status=Requested&page=1&pageSize=20
Authorization: Bearer {{returnAdminToken}}

### Approve, then repeat with Received, then Completed after full settlement
PUT {{baseUrl}}/admin/returns/{{returnId}}/status
Authorization: Bearer {{returnAdminToken}}
Content-Type: application/json

{"status":"Approved"}

### Refund a Received return
POST {{baseUrl}}/admin/returns/{{returnId}}/refund
Authorization: Bearer {{returnAdminToken}}
Idempotency-Key: return-refund-001
Content-Type: application/json

{"amountCents":5000}
