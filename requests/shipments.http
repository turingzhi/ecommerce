@baseUrl = http://127.0.0.1:5088
@accessToken = PASTE_ACCESS_TOKEN_HERE
@orderId = PASTE_NEW_PAID_ORDER_ID_HERE

### Read your shipment; retry after 404 while OrderPaid is awaiting consumption
GET {{baseUrl}}/orders/{{orderId}}/shipment
Authorization: Bearer {{accessToken}}

@adminAccessToken = PASTE_FRESH_ADMIN_ACCESS_TOKEN_HERE
@shipmentId = PASTE_SHIPMENT_ID_FROM_OWNER_READ_HERE

### Operator terminal first: docker compose exec -T ecommerce dotnet Ecommerce.Api.dll --grant-shipment-admin REGISTERED_EMAIL
### Log in again after granting permission; repeat with identical tracking to safely replay
PUT {{baseUrl}}/admin/shipments/{{shipmentId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{ "status": "Shipped", "trackingNumber": "TRACK-001" }

### Mark Delivered; repeat to replay without resetting timestamps
PUT {{baseUrl}}/admin/shipments/{{shipmentId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{ "status": "Delivered" }

### Browse admin shipments
GET {{baseUrl}}/admin/shipments?status=Delivered&page=1&pageSize=20
Authorization: Bearer {{adminAccessToken}}

### Admin history (includes actor identity)
GET {{baseUrl}}/admin/shipments/{{shipmentId}}/history
Authorization: Bearer {{adminAccessToken}}

### Owner tracking (without actor identity)
GET {{baseUrl}}/orders/{{orderId}}/tracking
Authorization: Bearer {{accessToken}}
