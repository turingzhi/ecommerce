@baseUrl = http://127.0.0.1:5088

### Search names and descriptions (no login required)
# Expected: 200, headphones and mouse
GET {{baseUrl}}/products/search?q=wireless

### Match the headphones description
# Expected: 200, headphones
GET {{baseUrl}}/products/search?q=bluetooth

### Match the mouse description
# Expected: 200, mouse
GET {{baseUrl}}/products/search?q=laptops

### No matches
# Expected: 200, []
GET {{baseUrl}}/products/search?q=no-such-product-7392108

### Missing query
# Expected: 400
GET {{baseUrl}}/products/search

### Blank query
# Expected: 400
GET {{baseUrl}}/products/search?q=%20%20
